{
  "name": "cappy",
  "version": "0.1.0",
  "private": true,
  "description": "Reproducible game capture: scenarios, replayable sessions, OBS recording, and FFmpeg derivatives.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "fixtures/adapter-simulator",
    "fixtures/fake-obs"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "build:distribution": "node scripts/build-distribution.mjs",
    "package:check": "node scripts/check-package.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "godot:demo": "node scripts/assemble-godot-demo.mjs .godot-demo",
    "model:check": "node scripts/model.mjs check",
    "model:render": "node scripts/model.mjs render",
    "schemas": "tsc -b && node scripts/schemas.mjs",
    "site:build": "node site/build.mjs",
    "site:types": "wrangler types site/worker-configuration.d.ts",
    "site:typecheck": "npm run site:types && tsc -p site/tsconfig.json",
    "site:dev": "npm run site:build && wrangler dev --port 4325",
    "site:check": "npm run site:build && npm run site:typecheck && node --test site/test/*.test.mjs"
  },
  "devDependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/workers-types": "5.20261021.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "5.3.0",
    "@hpcc-js/wasm-graphviz": "^1.29.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.13.6",
    "ajv": "6.15.0",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "marked": "18.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2",
    "wrangler": "4.151.3"
  }
}
