{
  "name": "cappy",
  "version": "0.1.0",
  "private": true,
  "description": "Reproducible game capture: scenarios, replayable sessions, OBS recording, and FFmpeg derivatives.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "fixtures/adapter-simulator",
    "fixtures/fake-obs"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "godot:demo": "node scripts/assemble-godot-demo.mjs .godot-demo",
    "model:check": "node scripts/model.mjs check",
    "model:render": "node scripts/model.mjs render",
    "schemas": "tsc -b && node scripts/schemas.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hpcc-js/wasm-graphviz": "^1.29.1",
    "@types/node": "^24.13.6",
    "ajv": "6.15.0",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
