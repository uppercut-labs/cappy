digraph Cappy {
  graph [rankdir=LR, splines=ortho, nodesep=0.55, ranksep=0.8];
  node [shape=box, style="rounded", fontname="Arial"];
  edge [fontname="Arial"];

  developer [label="Developer / Agent"];
  cli [label="Cappy CLI\ndoctor / scenarios / run / record / replay\nclean / compare\nHuman + JSON modes"];
  core [label="Cappy Controller\ncapture job state machine"];
  config [label="Project Config\ncappy.config.json (source-controlled)"];
  secrets [label="Environment\nOBS password (never stored)"];
  workspace [label="Managed Workspace\n.cappy/ or external root\nownership registry + retired takes"];
  sessions [label="Sessions\nsession.json + replay.bin + timeline.json"];
  logs [label="Correlated Logs + Run Locks\nlogs/, cache/running/"];
  protocol [label="Versioned Loopback\nWebSocket Protocol\n(session token)"];
  adapter [label="Game Adapter\n(capability owner)\ne.g. Godot addon"];
  game [label="Instrumented Game"];
  replay [label="Opaque Replay Payload"];
  timeline [label="Timeline\non the master clock"];
  obs [label="OBS\nRecorder"];
  ffmpeg [label="FFmpeg / ffprobe"];
  artifacts [label="Capture\nmaster + derivatives + manifest"];
  comparisons [label="Comparison\ntriptych + scores + worst frames\n+ timeline diff + manifest"];

  developer -> cli [label="commands"];
  cli -> core [label="commands"];
  config -> core [label="project + tool config"];
  secrets -> core [label="password by variable name"];
  core -> workspace [label="managed writes / safe cleanup"];
  workspace -> sessions [label="sessions/"];
  workspace -> artifacts [label="captures/"];
  workspace -> comparisons [label="comparisons/"];
  core -> logs [label="correlation ID"];

  core -> game [label="launch with endpoint + token"];
  core -> protocol [label="commands"];
  protocol -> adapter [label="JSON messages"];
  adapter -> game [label="scenario / replay"];
  game -> adapter [label="state / events"];
  adapter -> protocol [label="capabilities / events"];
  protocol -> core [label="validated messages"];

  adapter -> replay [label="recorded payload"];
  replay -> sessions [label="stored byte-for-byte"];
  sessions -> adapter [label="payload returned for replay"];
  core -> timeline [label="lifecycle events + sync"];
  adapter -> timeline [label="semantic events"];

  core -> obs [label="start / stop / verify"];
  obs -> artifacts [label="master (moved in, hashed)"];

  core -> ffmpeg [label="probe / derive"];
  artifacts -> ffmpeg [label="master input"];
  ffmpeg -> artifacts [label="MP4 / clips / stills\n(fixed or event-anchored)"];
  timeline -> ffmpeg [label="anchor resolution"];
  artifacts -> comparisons [label="two masters + timelines\n(same source)"];
  ffmpeg -> comparisons [label="SSIM / PSNR / triptych / stills"];

  sessions -> artifacts [label="source identity"];
  timeline -> artifacts [label="timing + events"];
}
