digraph Cappy {
  graph [rankdir=LR, splines=ortho, nodesep=0.55, ranksep=0.8];
  node [shape=box, style="rounded", fontname="Arial"];
  edge [fontname="Arial"];

  developer [label="Developer / Agent"];
  cli [label="Cappy CLI\nHuman + JSON modes"];
  core [label="Cappy Controller"];
  config [label="Project Config\n(source-controlled)"];
  workspace [label=".cappy/ Workspace\n(managed artifacts)"];
  protocol [label="Versioned Local\nWebSocket Protocol"];
  adapter [label="Game Adapter\n(capability owner)"];
  game [label="Instrumented Game"];
  replay [label="Opaque Replay Payload\n+ Session Metadata"];
  timeline [label="Normalized Timeline"];
  obs [label="OBS\nRecorder"];
  ffmpeg [label="FFmpeg / ffprobe"];
  artifacts [label="Master + Derivatives\n+ Manifest"];

  developer -> cli [label="run / record / replay"];
  cli -> core [label="commands"];
  config -> core [label="project + tool config"];
  core -> workspace [label="managed state"];

  core -> protocol [label="commands"];
  protocol -> adapter [label="JSON messages"];
  adapter -> game [label="scenario / replay"];
  game -> adapter [label="state / events"];
  adapter -> protocol [label="capabilities / events"];
  protocol -> core [label="validated messages"];

  core -> replay [label="store / load envelope"];
  replay -> adapter [label="opaque payload"];
  core -> timeline [label="normalize lifecycle"];
  adapter -> timeline [label="semantic events"];

  core -> obs [label="start / stop / verify"];
  obs -> artifacts [label="master"];

  core -> ffmpeg [label="inspect / derive"];
  artifacts -> ffmpeg [label="master input"];
  ffmpeg -> artifacts [label="MP4 / clips / stills"];

  replay -> artifacts [label="source identity"];
  timeline -> artifacts [label="timing + events"];
  workspace -> artifacts [label="managed ownership"];
}
