{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/uppercut-labs/cappy/blob/main/docs/schemas/timeline-event.schema.json",
  "title": "Cappy timeline event",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "enum": [
        "cappy",
        "adapter"
      ]
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "t": {
      "type": "number",
      "minimum": 0
    },
    "type": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "durationMs": {
      "type": "number",
      "minimum": 0
    },
    "payload": {},
    "correlationId": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "source",
    "seq",
    "t",
    "type"
  ],
  "additionalProperties": false
}
